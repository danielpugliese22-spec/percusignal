{
  "rewrites": [
    { "source": "/app",              "destination": "/app/" },
    { "source": "/privacidad",       "destination": "/privacidad.html" },
    { "source": "/terminos",         "destination": "/terminos.html" },
    { "source": "/club/:id",         "destination": "/club.html" },
    { "source": "/admin/clubs",      "destination": "/admin-clubs.html" },
    { "source": "/admin/club/:id",   "destination": "/admin-club.html" }
  ],
  "headers": [
    {
      "source": "/app/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self)" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/send-expiry-reminders",
      "schedule": "0 12 * * *"
    }
  ]
}
